{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fuzzy Music",
  "version": "0.1.0",
  "identifier": "io.github.kiruimaru.fuzzy-music",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Fuzzy Music", "width": 760, "height": 600, "minWidth": 320, "minHeight": 320 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://i1.sndcdn.com https://i2.sndcdn.com data:",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/**"] }
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
