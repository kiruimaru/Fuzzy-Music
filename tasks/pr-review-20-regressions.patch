--- a/review-release-discovery.rs
+++ b/review-release-discovery.rs
@@ -0,0 +1,12 @@
+#[path = "src-tauri/src/dependencies.rs"]
+mod dependencies;
+
+fn main() {
+    let discovered = dependencies::executable("FUZZY_REVIEW_UNUSED_OVERRIDE", "mpv");
+    println!("release mpv discovery: {}", discovered.display());
+    println!("discovered executable exists: {}", discovered.is_file());
+    assert!(
+        discovered.is_file(),
+        "system mpv exists on PATH but release discovery selects a missing tools/mpv"
+    );
+}
