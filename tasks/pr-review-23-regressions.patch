 mod tests {
     use super::*;
 
+    fn review_slow_server(
+        delay: std::time::Duration,
+        requests: usize,
+    ) -> (String, std::thread::JoinHandle<()>) {
+        use std::io::{Read, Write};
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let url = format!("http://{}", listener.local_addr().unwrap());
+        let worker = std::thread::spawn(move || {
+            for connection in listener.incoming().take(requests) {
+                let mut connection = connection.unwrap();
+                let mut request = [0u8; 2048];
+                connection.read(&mut request).unwrap();
+                std::thread::sleep(delay);
+                let _ = connection.write_all(
+                    b"HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\n{}",
+                );
+            }
+        });
+        (url, worker)
+    }
+
+    #[test]
+    fn review_cancellation_interrupts_an_inflight_http_request() {
+        use std::time::Duration;
+        let (url, server) = review_slow_server(Duration::from_millis(800), 1);
+        let options = RequestOptions {
+            timeout: Duration::from_secs(2),
+            ..Default::default()
+        };
+        let cancellation = options.cancellation.clone();
+        let canceller = std::thread::spawn(move || {
+            std::thread::sleep(Duration::from_millis(50));
+            cancellation.cancel();
+        });
+        let http = Http::new(&options, Some(&crate::network::NetworkPolicy::default())).unwrap();
+        let started = Instant::now();
+        let result = http.get(&url, &options);
+        let elapsed = started.elapsed();
+        canceller.join().unwrap();
+        server.join().unwrap();
+        assert!(matches!(result, Err(SoundCloudError::Cancelled)));
+        eprintln!("review: cancellation at 50ms returned after {elapsed:?}");
+        assert!(
+            elapsed < Duration::from_millis(300),
+            "cancelled request kept blocking"
+        );
+    }
+
+    #[test]
+    fn review_http_calls_share_the_operation_deadline() {
+        use std::time::Duration;
+        let (url, server) = review_slow_server(Duration::from_millis(150), 2);
+        let options = RequestOptions {
+            timeout: Duration::from_millis(250),
+            ..Default::default()
+        };
+        let http = Http::new(&options, Some(&crate::network::NetworkPolicy::default())).unwrap();
+        let started = Instant::now();
+        http.get(&url, &options).unwrap();
+        let second = http.get(&url, &options);
+        let elapsed = started.elapsed();
+        server.join().unwrap();
+        eprintln!(
+            "review: two HTTP calls completed after {elapsed:?}, budget {:?}",
+            options.timeout
+        );
+        assert!(
+            matches!(second, Err(SoundCloudError::TimedOut { .. })),
+            "operation exceeded timeout and still succeeded"
+        );
+    }
