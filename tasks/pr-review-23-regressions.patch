+        let url = format!("http://{}/list", listener.local_addr().unwrap());
+        let (started_tx, started_rx) = std::sync::mpsc::channel();
+        let server = std::thread::spawn(move || {
+            let workers: Vec<_> = listener.incoming().take(12).map(|connection| {
+                let started_tx = started_tx.clone();
+                std::thread::spawn(move || {
+                    let mut connection = connection.unwrap();
+                    let mut buffer = [0u8; 2048];
+                    connection.read(&mut buffer).unwrap();
+                    started_tx.send(()).unwrap();
+                    std::thread::sleep(Duration::from_millis(800));
+                    let body = "#EXTM3U\n#EXT-X-ENDLIST\n";
+                    let _ = write!(connection, "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}", body.len());
+                })
+            }).collect();
+            for worker in workers {
+                worker.join().unwrap();
+            }
+        });
+        Arc::get_mut(&mut shell).unwrap().audio_cache = Some(Arc::new(
+            audio_cache::AudioCache::new(&fuzzy_application::NetworkPolicy::default()).unwrap(),
+        ));
+        {
+            let mut control = shell.control.lock().unwrap();
+            let mut resolved = control.cached_streams[0].1.clone();
+            resolved.stream_url = url;
+            for index in 0..12 {
+                control.cached_streams.push((
+                    request(&format!("review{index}")).track_url,
+                    resolved.clone(),
+                    Instant::now(),
+                ));
+            }
+        }
+        for index in 0..12 {
+            shell
+                .play(index + 2, request(&format!("review{index}")))
+                .unwrap();
+        }
+        let mut parallel = 0;
+        while started_rx.recv_timeout(Duration::from_millis(200)).is_ok() {
+            parallel += 1;
+        }
+        shell.shutdown();
+        server.join().unwrap();
+        eprintln!("review: {parallel} simultaneous manifest downloads from manual skips");
+        assert!(
+            parallel <= 8,
+            "manual playback bypassed the lookahead worker limit"
+        );
